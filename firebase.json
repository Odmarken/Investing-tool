{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json", ".firebaserc", "firestore.rules",
      "functions/**", "node_modules/**", ".git/**",
      "*.md", "*.toml", "*.pine", "worker.js", "konto.js", "dev-server.js",
      "package.json", "package-lock.json", ".dev.vars*", ".dev-bars*"
    ],
    "rewrites": [
      { "source": "/api/**", "function": "api", "region": "europe-north1" }
    ],
    "headers": [
      { "source": "**/*.@(js|html)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs20",
    "predeploy": ["node kopiera-motor.js"]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
