{
  "name": "riptide-investments-panel",
  "productName": "Riptide",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Riptide Investments Panel — NQ-dashboard, signalmotor, TradingView-feed och lokal utvecklingsserver",
  "main": "electron/main.js",
  "author": "Odmarken",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "start": "node dev-server.js",
    "demo": "node dev-server.js --demo",
    "trana": "node trana.mjs",
    "worker:dev": "npx wrangler dev",
    "worker:deploy": "npx wrangler deploy",
    "worker:secret": "npx wrangler secret put FEED_KEY",
    "konto:tick": "curl -s \"http://localhost:8080/feed/konto/tick?k=dev\"",
    "fb:deploy": "node rulla-ut.js",
    "fb:functions": "node rulla-ut.js --only functions",
    "fb:nyckel": "npx firebase-tools functions:secrets:set FEED_KEY",
    "fb:tick": "npx firebase-tools functions:log --only kontoCron",
    "mat": "node matning-fonster.mjs",
    "app": "electron .",
    "app:exe": "node scripts/app-ikon.mjs && electron-builder --win portable"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "electron": "43.7.9",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "se.riptide.investments",
    "productName": "Riptide",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!research/**",
      "!tests/**",
      "!functions/**",
      "!scripts/**",
      "!dist/**",
      "!build/**",
      "!**/*.md",
      "!**/*.pine",
      "!**/*.toml",
      "!trana.mjs",
      "!matning-fonster.mjs",
      "!rulla-ut.js",
      "!kopiera-motor.js",
      "!firebase.json",
      "!firestore.rules",
      "!.*",
      "!.*/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "portable": {
      "artifactName": "Riptide.exe"
    }
  }
}
