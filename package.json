{
  "name": "signaldesk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Signaldesk NQ/Guld — dashboard, TradingView-feed via Cloudflare Worker och lokal utvecklingsserver",
  "scripts": {
